+// TestClassifyFilterResponse pins the outcome verdicts of one filter response
+// (plan §7.3): a parsed approve-all/empty set is success, malformed arguments
+// or unparseable text is degradation, and no decision material never counts as
+// a parsed decision.
+func TestClassifyFilterResponse(t *testing.T) {
+	call := func(name, args string) []llm.ToolCall {
+		return []llm.ToolCall{{Function: llm.FunctionCall{Name: name, Arguments: args}}}
+	}
+	for _, tc := range []struct {
+		name        string
+		calls       []llm.ToolCall
+		content     string
+		wantIndices int
+		wantNil     bool
+		wantVerdict managedFilterParse
+	}{
+		{
+			name:        "approve-all tool call is a valid decision",
+			calls:       call("approve_all_comments", "{}"),
+			wantIndices: 0,
+			wantVerdict: managedFilterParse{received: true, parsed: true},
+		},
+		{
+			name:        "removal tool call is a valid decision",
+			calls:       call("report_incorrect_comments", `{"comment_ids":["c-0"]}`),
+			wantIndices: 1,
+			wantVerdict: managedFilterParse{received: true, parsed: true},
+		},
+		{
+			name:        "malformed tool arguments degrade with preserved comments",
+			calls:       call("report_incorrect_comments", `not json`),
+			wantNil:     true,
+			wantVerdict: managedFilterParse{received: true, malformed: true},
+		},
+		{
+			name:        "text fallback parses an empty removal set",
+			content:     `[]`,
+			wantIndices: 0,
+			wantVerdict: managedFilterParse{received: true, parsed: true},
+		},
+		{
+			name:        "unparseable text decision degrades",
+			content:     `I think all comments are fine`,
+			wantNil:     true,
+			wantVerdict: managedFilterParse{received: true, malformed: true},
+		},
+		{
+			name:        "no decision material never counts as parsed",
+			wantNil:     true,
+			wantVerdict: managedFilterParse{},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			indices, verdict := classifyFilterResponse(tc.calls, tc.content, 5)
+			if verdict != tc.wantVerdict {
+				t.Fatalf("verdict = %+v, want %+v", verdict, tc.wantVerdict)
+			}
+			if tc.wantNil {
+				if indices != nil {
+					t.Fatalf("indices = %v, want nil", indices)
+				}
+				return
+			}
+			if indices == nil || len(indices) != tc.wantIndices {
+				t.Fatalf("indices = %v, want %d entries", indices, tc.wantIndices)
+			}
+		})
+	}
+}
